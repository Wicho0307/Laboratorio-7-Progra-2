{
  "info": {
    "_postman_id": "f395dbb8-9c91-4d31-81cf-a6f5d1a60ef5",
    "name": "Laboratorio 7 - Profesores, Proveedores y Empleados",
    "description": "Colección para probar los tres ejercicios. Ejecute primero la petición Crear de cada carpeta para guardar automáticamente el ID generado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "apiKey",
      "value": "laboratorio7-key"
    },
    {
      "key": "profesorId",
      "value": "1"
    },
    {
      "key": "proveedorId",
      "value": "1"
    },
    {
      "key": "empleadoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Ejercicio 1 - Profesores",
      "item": [
        {
          "name": "Crear profesor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Profesor creado: 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const profesor = pm.response.json();",
                  "pm.collectionVariables.set('profesorId', profesor.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"García\",\n  \"correo\": \"ana@universidad.com\",\n  \"especialidad\": \"Matemática\",\n  \"estado\": \"ACTIVO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/profesores"
          }
        },
        {
          "name": "Consultar profesores",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/profesores"
          }
        },
        {
          "name": "Filtrar profesores por especialidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/profesores?especialidad=Matem%C3%A1tica"
          }
        },
        {
          "name": "Consultar profesor por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/profesores/{{profesorId}}"
          }
        },
        {
          "name": "Consultar profesor inexistente - 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Profesor inexistente: 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/profesores/99999"
          }
        }
      ]
    },
